# function to check whether

def matchwords(worfs):
  ctr = 0
  lst = []
  for word in worfs:
   if len(word) > 1 and word[0] == word[-1]:
     ctr += 1
     lst.append(word)

  print("list of words with the first and last charcter same \n")
  return ctr
 
